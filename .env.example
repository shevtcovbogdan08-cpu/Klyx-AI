# ============================================================
# Klyx AI — пример переменных окружения
# Скопируйте этот файл в .env и заполните значения.
# Файл .env НИКОГДА не загружайте в GitHub.
# ============================================================

# --- Обязательные секреты ---
BOT_TOKEN=123456789:AAExampleTelegramBotTokenFromBotFather
OPENROUTER_API_KEY=sk-or-v1-example-openrouter-key
GROQ_API_KEY=gsk_example-groq-key

# --- Telegram / OpenRouter (необязательно, есть значения по умолчанию) ---
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=https://github.com/klyx-ai
# OPENROUTER_APP_NAME=Klyx AI

# --- Список бесплатных моделей OpenRouter (через запятую, без пробелов) ---
# OPENROUTER_FREE_MODELS=deepseek/deepseek-chat-v3-0324:free,meta-llama/llama-3.3-70b-instruct:free,qwen/qwen-2.5-72b-instruct:free,google/gemma-3-27b-it:free

# --- Groq ---
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Лимиты ---
# DAILY_USER_LIMIT=50
# GLOBAL_REQUESTS_PER_MINUTE=20
# MAX_CONCURRENT_AI_REQUESTS=3

# --- Таймауты (в секундах) ---
# OPENROUTER_TIMEOUT=90
# GROQ_TIMEOUT=60
# TELEGRAM_REQUEST_TIMEOUT=60

# --- Ограничения файлов ---
# MAX_TXT_FILE_SIZE_BYTES=2097152
# MAX_PDF_FILE_SIZE_BYTES=10485760
# MAX_PDF_PAGES=50
# MAX_HISTORY_MESSAGES=20
# MAX_MEMORY_FACTS=20

# --- База данных ---
# DATABASE_PATH=database.db

# --- Логирование ---
# LOG_LEVEL=INFO