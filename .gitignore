.venv/
venv/
env/
ENV/
.python-version

# Инструменты разработки и кеши
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# IDE / редакторы
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Логи
*.log
logs/

